# ===========================================
# PHASE 3 - AI-ENABLED SERVICES ENVIRONMENT
# ===========================================

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educrm
DB_USER=postgres
DB_PASSWORD=your_secure_password_here

# Redis Configuration (for BI caching and queues)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Authentication
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Service Ports
BUSINESS_INTELLIGENCE_PORT=3010
REPORT_SERVICE_PORT=3010
AI_ANALYTICS_PORT=3012
ALERTS_PORT=3013
CRM_PORT=3014
ALUMNI_PORT=3015

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200

# Node Environment
NODE_ENV=development

# Logging
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# Report Generation
REPORTS_STORAGE_PATH=./storage/reports
REPORTS_TEMP_PATH=./storage/temp

# Email Configuration (for alerts)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@educrm.com

# SMS Configuration (for alerts)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# Push Notification Configuration
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_PRIVATE_KEY=your_private_key
FIREBASE_CLIENT_EMAIL=your_client_email

# AI/ML Configuration
AI_MODEL_STORAGE_PATH=./storage/models
AI_CONFIDENCE_THRESHOLD=0.75

# Alert Evaluation Schedule (cron format)
ALERT_EVALUATION_SCHEDULE=0 */6 * * *  # Every 6 hours

# Report Generation Queue
REPORT_QUEUE_CONCURRENCY=5
REPORT_QUEUE_MAX_ATTEMPTS=3

# Cache Configuration
CACHE_TTL_SECONDS=300
CACHE_MAX_SIZE=1000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Limits
MAX_FILE_SIZE=10485760  # 10MB
ALLOWED_FILE_TYPES=pdf,xlsx,csv,json

# Pagination Defaults
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# Session Configuration
SESSION_TIMEOUT_MINUTES=60

# Security
BCRYPT_ROUNDS=10
HELMET_ENABLED=true
CORS_ENABLED=true

# Monitoring (Optional)
SENTRY_DSN=
NEW_RELIC_LICENSE_KEY=

# Feature Flags
ENABLE_AI_PREDICTIONS=true
ENABLE_AUTOMATED_ALERTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
