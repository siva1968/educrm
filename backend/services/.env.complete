# ===================================================================
# EDUCRM PLATFORM - COMPLETE ENVIRONMENT CONFIGURATION
# ===================================================================
# Generated: November 19, 2025
# Total Services: 54 microservices
# ===================================================================

# ===================================================================
# DATABASE CONFIGURATION
# ===================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=educrm
DB_USER=postgres
DB_PASSWORD=your_secure_password_change_in_production
DB_POOL_MIN=2
DB_POOL_MAX=20
DB_SSL=false  # Set to true in production

# ===================================================================
# REDIS CONFIGURATION
# ===================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Redis Cluster (for production)
REDIS_CLUSTER_ENABLED=false
REDIS_CLUSTER_NODES=localhost:7001,localhost:7002,localhost:7003

# ===================================================================
# JWT & AUTHENTICATION
# ===================================================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# ===================================================================
# CORS CONFIGURATION
# ===================================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4200
CORS_ENABLED=true

# ===================================================================
# NODE ENVIRONMENT
# ===================================================================
NODE_ENV=development  # development, staging, production
LOG_LEVEL=info  # error, warn, info, debug
LOG_FILE_PATH=./logs

# ===================================================================
# PHASE 4: FOUNDATION & AI SERVICES (Ports 4000-4013)
# ===================================================================

# GraphQL API Gateway
GRAPHQL_GATEWAY_PORT=4000
GRAPHQL_INTROSPECTION=true  # Disable in production
GRAPHQL_PLAYGROUND=true  # Disable in production

# NLP Service
NLP_SERVICE_PORT=4001
NLP_MODEL_PATH=./storage/models/nlp
NLP_CONFIDENCE_THRESHOLD=0.75

# Computer Vision Service
CV_SERVICE_PORT=4002
CV_MODEL_PATH=./storage/models/cv
TESSERACT_PATH=/usr/bin/tesseract  # Adjust for your system

# Prediction Engine
PREDICTION_ENGINE_PORT=4003
PREDICTION_MODEL_PATH=./storage/models/predictions
PREDICTION_TRAINING_ENABLED=false  # Enable only in training environment

# Payment Gateway
PAYMENT_GATEWAY_PORT=4004
# Razorpay (India)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Stripe (International)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Communication Service
COMMUNICATION_SERVICE_PORT=4005
# Twilio (SMS)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
# SendGrid (Email)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@educrm.com
SENDGRID_FROM_NAME=EduCRM System
# WhatsApp Business API
WHATSAPP_API_TOKEN=your_whatsapp_api_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Firebase Cloud Messaging (Push Notifications)
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# SSO Service
SSO_SERVICE_PORT=4006
SSO_BASE_URL=http://localhost:4006
# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:4006/api/v1/sso/google/callback
# Microsoft Azure AD
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=your_microsoft_tenant_id
MICROSOFT_CALLBACK_URL=http://localhost:4006/api/v1/sso/microsoft/callback

# Mobile API Layer
MOBILE_API_PORT=4007
MOBILE_API_RATE_LIMIT=500  # requests per 15 minutes
MOBILE_CACHE_TTL=300  # 5 minutes in seconds

# Advanced Analytics Service
ANALYTICS_SERVICE_PORT=4010
ANALYTICS_CACHE_TTL=600  # 10 minutes

# Workflow Engine
WORKFLOW_ENGINE_PORT=4013
WORKFLOW_MAX_CONCURRENT=10

# ===================================================================
# PHASE 5: STUDENT MANAGEMENT SERVICES (Ports 4100-4105)
# ===================================================================

SIS_PORT=4100  # Student Information Service
ATTENDANCE_PORT=4101  # Attendance Management Service
GATEPASS_PORT=4102  # Student Gate Pass Service
LEARNER_PROFILE_PORT=4103  # Learner Profile Service
LOGIN_STATS_PORT=4104  # Login Statistics Service
ACHIEVEMENT_PORT=4105  # Achievement Tracking Service

# ===================================================================
# PHASE 5: ACADEMIC MANAGEMENT SERVICES (Ports 4110-4117)
# ===================================================================

TIMETABLE_PORT=4110  # Timetable Management Service
GRADEBOOK_PORT=4111  # Grade Book Service
EXAMINATION_PORT=4112  # Examination Management Service
ASSIGNMENT_PORT=4113  # Assignment Management Service
SUBJECT_PORT=4114  # Subject Management Service
LMS_PORT=4115  # Learning Management System
TEACHING_PLAN_PORT=4116  # Teaching Plan Service
ONLINE_CLASSES_PORT=4117  # Online Classes Service

# ===================================================================
# PHASE 5: CONTENT & RESOURCES SERVICES (Ports 4120-4122)
# ===================================================================

CONTENT_MANAGEMENT_PORT=4120  # Content Management Service
LIBRARY_PORT=4121  # Library Management Service
CERTIFICATE_PORT=4122  # Certificate Management Service

# ===================================================================
# PHASE 5: HR & ADMINISTRATION SERVICES (Ports 4130-4134)
# ===================================================================

HR_PORT=4130  # HR Management Service
PAYROLL_PORT=4131  # Payroll Management Service
LEAVE_MANAGEMENT_PORT=4132  # Leave Management Service
PERFORMANCE_PORT=4133  # Performance Management Service (PMS)
VISITOR_PORT=4134  # Visitor Management Service

# ===================================================================
# PHASE 5: FINANCE SERVICES (Ports 4140-4142)
# ===================================================================

FEE_MANAGEMENT_PORT=4140  # Fee Management Service
COLLECTIONS_PORT=4141  # Collections Management Service
ACCOUNTING_PORT=4142  # Financial Accounting Service

# ===================================================================
# PHASE 5: TRANSPORT & FACILITIES SERVICES (Ports 4150-4152)
# ===================================================================

FLEET_MANAGEMENT_PORT=4150  # Fleet Management Service
TRANSPORT_SAFETY_PORT=4151  # Transport Safety Service
MAINTENANCE_PORT=4152  # Vehicle Maintenance Service

# ===================================================================
# PHASE 5: INVENTORY & OPERATIONS SERVICES (Ports 4160-4161)
# ===================================================================

INVENTORY_PORT=4160  # Inventory Management Service
DYNAMIC_FORMS_PORT=4161  # Dynamic Forms Service

# ===================================================================
# PHASE 5: CRM & ADMISSIONS SERVICES (Ports 4170-4174)
# ===================================================================

LEAD_MANAGEMENT_PORT=4170  # Lead Management Service
ADMISSIONS_PORT=4171  # Admissions Processing Service
CRM_PORT=4172  # CRM Service
ALUMNI_PORT=4173  # Alumni Management Service
ECOMMERCE_PORT=4174  # E-commerce Service

# ===================================================================
# PHASE 5: SPECIALIZED SERVICES (Ports 4180-4185)
# ===================================================================

ECA_SPORTS_PORT=4180  # ECA & Sports Management Service
PRESCHOOL_PORT=4181  # Pre-School Management Service
SCHOOL_DRIVE_PORT=4182  # School Drive Service
CONCERN_MANAGEMENT_PORT=4183  # Concern Management Service
SQAA_PORT=4184  # SQAA Service
NAAC_NIRF_PORT=4185  # NAAC & NIRF Service

# ===================================================================
# FILE STORAGE & UPLOADS
# ===================================================================
STORAGE_PATH=./storage
UPLOADS_PATH=./storage/uploads
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=pdf,xlsx,csv,doc,docx,jpg,jpeg,png,gif

# Documents
DOCUMENTS_STORAGE_PATH=./storage/documents
# Reports
REPORTS_STORAGE_PATH=./storage/reports
REPORTS_TEMP_PATH=./storage/temp
# Certificates
CERTIFICATES_STORAGE_PATH=./storage/certificates

# ===================================================================
# PAGINATION DEFAULTS
# ===================================================================
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200

# ===================================================================
# RATE LIMITING
# ===================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes in milliseconds
RATE_LIMIT_MAX_REQUESTS=100  # Max requests per window per IP

# ===================================================================
# SESSION CONFIGURATION
# ===================================================================
SESSION_SECRET=your_session_secret_change_in_production
SESSION_TIMEOUT_MINUTES=60
SESSION_COOKIE_SECURE=false  # Set to true in production with HTTPS

# ===================================================================
# SECURITY
# ===================================================================
BCRYPT_ROUNDS=10
HELMET_ENABLED=true
CSRF_ENABLED=true
HTTPS_ONLY=false  # Set to true in production

# ===================================================================
# MONITORING & OBSERVABILITY
# ===================================================================

# Prometheus
PROMETHEUS_ENABLED=true
PROMETHEUS_PORT=9090

# Grafana
GRAFANA_ENABLED=false
GRAFANA_PORT=3000

# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# New Relic
NEW_RELIC_LICENSE_KEY=
NEW_RELIC_APP_NAME=educrm-platform

# ===================================================================
# FEATURE FLAGS
# ===================================================================
ENABLE_AI_PREDICTIONS=true
ENABLE_AUTOMATED_ALERTS=true
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_SMS_NOTIFICATIONS=false
ENABLE_PUSH_NOTIFICATIONS=false
ENABLE_WEBSOCKET=false
ENABLE_AUDIT_LOGS=true
ENABLE_SOFT_DELETE=true

# ===================================================================
# AI/ML CONFIGURATION
# ===================================================================
AI_MODEL_STORAGE_PATH=./storage/models
AI_CONFIDENCE_THRESHOLD=0.75
AI_BATCH_SIZE=32
AI_MAX_TRAINING_EPOCHS=100

# ===================================================================
# BACKUP CONFIGURATION
# ===================================================================
BACKUP_ENABLED=false
BACKUP_PATH=./backups
BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM (cron format)
BACKUP_RETENTION_DAYS=30

# ===================================================================
# VIDEO CONFERENCING INTEGRATION
# ===================================================================
# Zoom
ZOOM_API_KEY=
ZOOM_API_SECRET=
# Microsoft Teams
TEAMS_CLIENT_ID=
TEAMS_CLIENT_SECRET=
# Google Meet
MEET_CLIENT_ID=
MEET_CLIENT_SECRET=

# ===================================================================
# CACHE CONFIGURATION
# ===================================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=300  # 5 minutes default
CACHE_MAX_SIZE=1000  # Max cache entries

# ===================================================================
# QUEUE CONFIGURATION (Bull)
# ===================================================================
QUEUE_ENABLED=false
QUEUE_CONCURRENCY=5
QUEUE_MAX_ATTEMPTS=3
QUEUE_BACKOFF_DELAY=5000  # 5 seconds

# ===================================================================
# TIMEZONE
# ===================================================================
TZ=Asia/Kolkata  # Change to your timezone

# ===================================================================
# LOCALIZATION
# ===================================================================
DEFAULT_LANGUAGE=en
SUPPORTED_LANGUAGES=en,hi,es,fr

# ===================================================================
# SCHOOL/TENANT CONFIGURATION
# ===================================================================
MULTI_TENANCY_ENABLED=true
DEFAULT_SCHOOL_ID=

# ===================================================================
# END OF CONFIGURATION
